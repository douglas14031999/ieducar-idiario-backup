# ==============================================================================
# CONFIGURAÇÃO DE BACKUP AUTOMATIZADO - I-EDUCAR E I-DIÁRIO -> MINIO
# ==============================================================================
# IMPORTANTE: Copie este arquivo para '/etc/ieducar-backup/.env' no servidor.
# Permissões recomendadas: chmod 600 /etc/ieducar-backup/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações do MinIO
# ------------------------------------------------------------------------------
# URL do MinIO para conexão interna do script (geralmente localhost na porta 9000)
MINIO_ENDPOINT="http://127.0.0.1:9000"

# Credenciais de acesso ao MinIO
MINIO_ACCESS_KEY="admin"
MINIO_SECRET_KEY="Douglas140399."

# Nome do Bucket onde os backups serão guardados
MINIO_BUCKET="ieducar-backups"

# Diretório onde os dados brutos do MinIO são persistidos no disco da VPS
MINIO_DATA_DIR="/data/minio"

# Alias interno usado pelo utilitário mc (MinIO Client)
MINIO_ALIAS="local-minio"

# ------------------------------------------------------------------------------
# 2. Política de Retenção e Agendamento
# ------------------------------------------------------------------------------
# Quantidade de dias para manter os backups antes de expirar/apagar
RETENTION_DAYS=20

# Expressão do Cron (Padrão: Todos os dias às 23:59)
CRON_SCHEDULE="59 23 * * *"

# Diretório local para armazenar temporariamente o backup antes do upload
LOCAL_BACKUP_DIR="/var/backups/ieducar-idiario"

# Arquivo de log detalhado
LOG_FILE="/var/log/ieducar-backup.log"

# ------------------------------------------------------------------------------
# 3. Configurações do i-Educar
# ------------------------------------------------------------------------------
# Modo de execução: 'auto' (detecta docker ou host), 'docker' ou 'baremetal'
IEDUCAR_ENABLED=true
IEDUCAR_MODE="auto"

# Se Docker: nome ou parte do nome do container do PostgreSQL
IEDUCAR_CONTAINER_DB="ieducar-database"

# Dados do PostgreSQL (usado para modo baremetal ou conexão direta)
IEDUCAR_DB_HOST="127.0.0.1"
IEDUCAR_DB_PORT="5432"
IEDUCAR_DB_NAME="ieducar"
IEDUCAR_DB_USER="ieducar"
IEDUCAR_DB_PASSWORD="sua_senha_aqui"

# Diretório de arquivos/uploads do i-Educar para backup
# Exemplo Docker: volume do storage ou caminho no host: /var/www/ieducar/storage
IEDUCAR_STORAGE_PATH="/var/www/ieducar/storage"

# ------------------------------------------------------------------------------
# 4. Configurações do i-Diário
# ------------------------------------------------------------------------------
# Modo de execução: 'auto' (detecta docker ou host), 'docker' ou 'baremetal'
IDIARIO_ENABLED=true
IDIARIO_MODE="auto"

# Se Docker: nome ou parte do nome do container do PostgreSQL
IDIARIO_CONTAINER_DB="idiario-database"

# Dados do PostgreSQL (usado para modo baremetal ou conexão direta)
IDIARIO_DB_HOST="127.0.0.1"
IDIARIO_DB_PORT="5432"
IDIARIO_DB_NAME="idiario_production"
IDIARIO_DB_USER="idiario"
IDIARIO_DB_PASSWORD="sua_senha_aqui"

# Diretório de arquivos/uploads do i-Diário para backup
# Exemplo Docker: volume de uploads ou caminho no host: /var/www/idiario/public/system
IDIARIO_STORAGE_PATH="/var/www/idiario/public/system"

# ------------------------------------------------------------------------------
# 5. Sincronização Pré-Backup: i-Diário com o i-Educar
# ------------------------------------------------------------------------------
# Executar sincronização antes de iniciar os dumps de banco de dados
SYNC_BEFORE_BACKUP="true"
IDIARIO_APP_DIR="/root/i-diario"
IDIARIO_SYNC_COMMAND="RAILS_ENV=production bundle exec rake ieducar_api:synchronize"
IDIARIO_SYNC_WAIT_SECONDS="15"
IDIARIO_SYNC_IGNORE_FAILURES="true"

# ------------------------------------------------------------------------------
# 6. Notificações Opcionais (Discord / Telegram)
# ------------------------------------------------------------------------------
# Envie alertas caso o backup falhe ou complete com sucesso
# Webhook do Discord (deixe vazio se não quiser usar)
DISCORD_WEBHOOK_URL=""

# Telegram Bot (deixe vazio se não quiser usar)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
